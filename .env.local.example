# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

# Cursor TEAM ADMIN API key. Note this is NOT the same as a "User API Key"
# whose scope happens to say "Admin" — that one returns 401 on every /teams/*
# endpoint. Created from the team dashboard by a team admin.
CURSOR_API_KEY=crsr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Budgets, USD. Set these to your own team's numbers.
MONTHLY_BUDGET_USD=1000
ON_DEMAND_BUDGET_USD=500

# 'file' for local, 'bigquery' on Cloud Run.
STORAGE_DRIVER=file
DATA_DIR=./data

# Only needed when STORAGE_DRIVER=bigquery
# GCP_PROJECT_ID=your-gcp-project
# BQ_DATASET=cursor_usage
# BQ_LOCATION=US

PORT=8080
